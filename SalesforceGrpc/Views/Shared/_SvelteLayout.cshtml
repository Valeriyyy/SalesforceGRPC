@model SalesforceGrpc.ViewModels.SveltePage
<!DOCTYPE html>
<html lang="en" data-theme="cerberus">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Model.Title · SalesforceGRPC</title>
    <script>
        /* Apply the saved light/dark choice (or the OS preference) before first paint. */
        (function () {
            var mode;
            try { mode = localStorage.getItem("mode"); } catch (e) { }
            if (mode !== "light" && mode !== "dark") {
                mode = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-mode", mode);
        })();
    </script>
</head>
<body>
<div id="app"
     data-component="@Model.Component"
     data-props="@Model.Props">
    @RenderBody()
</div>
<vite-entry src="src/pages/app.ts" />
</body>
</html>